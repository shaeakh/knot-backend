generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AccessControll {
  roleId               String @id @default(uuid())
  roleName             String @unique
  userModule           Json
  tshirtModule         Json
  accessControllModule Json
  authModule           Json
  users                User[]
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId String         @default("f9e74c8b-5a12-4c6e-8d9e-1a2b3c4d5e6f")
  role   AccessControll @relation(fields: [roleId], references: [roleId])
}

model TshirtSize {
  id     String @id @unique @default(uuid())
  size   String @unique
  length Float
  height Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tshirt {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Float

  variants TshirtVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TshirtVariant {
  id       String @id @default(uuid())
  tshirtId String
  tshirt   Tshirt @relation(fields: [tshirtId], references: [id], onDelete: Cascade)

  color       String
  size        String
  stock       Int     @default(0)
  images      String
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tshirtId, color, size])
}
