generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AccessControll {
  roleId               String @id @default(uuid())
  roleName             String @unique
  userModule           Json
  itemModule           Json
  accessControllModule Json
  users                User[]
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId String         @default("f9e74c8b-5a12-4c6e-8d9e-1a2b3c4d5e6f")
  role   AccessControll @relation(fields: [roleId], references: [roleId])
}

model ItemSize {
  id     String @id @unique @default(uuid())
  size   String @unique
  length Float
  height Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id          String  @id @default(uuid())
  name        String
  type        String // "tshirt", "hoodie", "jacket"
  description String?
  price       Float

  colors ItemColorVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemColorVariant {
  id     String @id @default(uuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  color  String // "red", "blue", "green"
  images String

  sizes ItemSizeStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, color])
}

model ItemSizeStock {
  id String @id @default(uuid())

  colorVariantId String
  colorVariant   ItemColorVariant @relation(fields: [colorVariantId], references: [id], onDelete: Cascade)

  size  String // "M", "L", "XL"
  stock Int    @default(0)

  @@unique([colorVariantId, size])
}
